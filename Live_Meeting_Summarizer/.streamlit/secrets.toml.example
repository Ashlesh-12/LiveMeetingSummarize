# .streamlit/secrets.toml
# -------------------------------------------------------
# DO NOT COMMIT THIS FILE — it is already in .gitignore
# -------------------------------------------------------
# Paste this content into Streamlit Cloud → App Settings → Secrets
#
# Replace the hash below with a real bcrypt hash, or leave it
# to use the auto-created demo/demo1234 account.
#
# To generate a bcrypt hash in Python:
#   import bcrypt
#   print(bcrypt.hashpw(b"yourpassword", bcrypt.gensalt()).decode())
#
# [users]
# Ashlesh = "$2b$12$<paste_your_bcrypt_hash_here>"
# demo    = "$2b$12$<another_hash>"
