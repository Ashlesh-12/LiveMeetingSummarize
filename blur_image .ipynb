       "\n",
       "     <input type=\"file\" id=\"files-c3b34014-bd0e-40e2-a066-ce7e28dfd5ec\" name=\"files[]\" multiple disabled\n",
       "        style=\"border:none\" />\n",
       "     <output id=\"result-c3b34014-bd0e-40e2-a066-ce7e28dfd5ec\">\n",
       "      Upload widget is only available when the cell has been executed in the\n",
       "      current browser session. Please rerun this cell to enable.\n",
       "      </output>\n",
       "      <script>// Copyright 2017 Google LLC\n",
